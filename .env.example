# Copia este archivo a .env (desarrollo) o define estas variables en tu proveedor de hosting (producción).

# URL pública definitiva, SIN barra final. Se usa en canonical, sitemap, Open Graph y JSON-LD.
# En producción es obligatoria: la compilación falla si falta.
VITE_SITE_URL=https://www.tudominio.com

# Endpoint real para recibir formularios (Formspree, Web3Forms, Getform, tu propio backend...).
# Ejemplo Formspree: https://formspree.io/f/xxxxxxxx   | Web3Forms: https://api.web3forms.com/submit
VITE_FORM_ENDPOINT=

# Solo si usas Web3Forms (clave pública de acceso). Déjalo vacío con otros servicios.
VITE_FORM_ACCESS_KEY=

# "false" en entornos de pruebas/staging: añade noindex y robots.txt con Disallow: /
VITE_ALLOW_INDEXING=true

# "true" genera source maps "hidden" (sin referencia pública) para depuración privada.
BUILD_SOURCEMAP=false
